# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this

# JWT settings
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google OAuth — from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Groq AI — from https://console.groq.com/keys (free, no credit card required)
# Model used: llama-3.3-70b-versatile (production, not deprecated)
GROQ_API_KEY=your-groq-api-key

# Database — SQLite (default) or PostgreSQL
# SQLite (no setup needed):
DATABASE_URL=sqlite:///./ai_todo.db
# PostgreSQL (optional):
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_todo

# Allowed frontend origins for CORS
FRONTEND_URL=http://localhost:3000
